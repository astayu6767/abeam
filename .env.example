# Runtime
NODE_ENV=production
PORT=8080
APP_URL=https://YOUR-SERVICE.up.railway.app
SESSION_SECRET=replace-with-a-long-random-secret

# Authentication (set either Discord OAuth or use email/password)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
ADMIN_DISCORD_IDS=
ADMIN_TOKEN=replace-with-a-separate-admin-token

# Bot manager (Azalea is the default engine for /api/bots)
BOT_CONNECTION_TIMEOUT_MS=45000
AZALEA_BRIDGE_BIN=/usr/local/bin/azalea-bridge
RUST_LOG=warn
# Optional only for the legacy /api/slots executable supervisor:
# BOT_EXE=/app/bin/abeam
# BACKEND_WS_URL=wss://YOUR-SERVICE.up.railway.app/ws/bot

# Billing / optional integrations
LTC_SEED=
BLOCKCYPHER_TOKEN=
LTC_USD_RATE=60
LTC_NETWORK=main
LTC_CONFIRMATIONS=1
AI_API_KEY=
WEBHOOK_URL=
DEVLOG_WEBHOOK_URL=
